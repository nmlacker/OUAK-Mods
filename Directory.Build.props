<Project>
  <!--
    Shared build settings for every project under ModMenuSource: the OUAK Modding API, the OUAK Mod Menu,
    OUAK Multiplayer and the samples. A project only needs its name, its references and (for a hot mod)
    InstallDir. Override the game folder with -p:GameDir=...
  -->
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <DebugType>none</DebugType>
    <NoWarn>$(NoWarn);CS0618;MSB3277;NU1903</NoWarn>
    <!-- Game install root: ModMenuSource sits in the game folder. -->
    <GameDir Condition="'$(GameDir)' == ''">$(MSBuildThisFileDirectory)..\</GameDir>
    <!-- Where the build puts the DLL: Mods for MelonLoader mods, UserData\OUAKModAPI\HotMods for hot mods. -->
    <InstallDir Condition="'$(InstallDir)' == ''">$(GameDir)Mods</InstallDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(GameDir)MelonLoader\net6\MelonLoader.dll" Private="false" />
    <Reference Include="$(GameDir)MelonLoader\net6\0Harmony.dll" Private="false" />
    <Reference Include="$(GameDir)MelonLoader\net6\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(GameDir)MelonLoader\net6\Il2CppInterop.Common.dll" Private="false" />
    <Reference Include="$(GameDir)MelonLoader\Il2CppAssemblies\*.dll" Private="false" />
    <!-- Dear ImGui (the API's windows). Not copied next to the mod: the API installs it to UserLibs. -->
    <PackageReference Include="ImGui.NET" Version="1.91.6.1" />
  </ItemGroup>

  <!-- The running game locks the DLLs in Mods; the build still succeeds and says so. -->
  <Target Name="CopyToMods" AfterTargets="Build" Condition="'$(NoInstall)' != 'true'">
    <MakeDir Directories="$(InstallDir)" ContinueOnError="true" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(InstallDir)" Retries="0" ContinueOnError="true">
      <Output TaskParameter="CopiedFiles" ItemName="_Installed" />
    </Copy>
    <Message Importance="high" Condition="'@(_Installed)' != ''" Text="Installed $(TargetFileName) to $(InstallDir)" />
    <Message Importance="high" Condition="'@(_Installed)' == ''" Text="NOT installed: close the game, then build again." />
  </Target>
</Project>
