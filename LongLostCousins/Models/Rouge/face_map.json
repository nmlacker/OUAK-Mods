  "ouak": {
   "blinkEyeType": 2,
   "blink_eye": "eye_03",
   "open_seconds": 3.0,
   "closed_seconds": 0.15
  },
  "new_style": "eye_03_m for 0.15 s every 3.0 s on groups that blink"
 },
 "rouge_new_pieces": {
  "eye_01_m": "her usual eyes: the Prince's, grey almonds with their outer ends tilted up",
  "eye_02_m": "half-closed: the dots' lower half",
