  "eye_04_m": "round dot eyes",
  "eye_05_m": "white eyes with a thin dark outline",
  "face_01_m": "face plate in its gold window frame, its top in the gold ring, with her hair as the photo (File:Ruz.jpg) and rosy cheeks",
  "face_02_m": "face plate, blue-grey shade under the fringe",
  "face_03_m": "face plate, red flush under the fringe",
